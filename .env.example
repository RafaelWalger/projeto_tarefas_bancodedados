# Copie este arquivo para .env e preencha com os dados do SEU banco Oracle.
# (o arquivo .env NÃO vai para o GitHub: ele está no .gitignore)
ORACLE_USER=seu_usuario
ORACLE_PASSWORD=sua_senha
ORACLE_HOST=localhost
ORACLE_PORT=1521
# Use os mesmos dados que você usa para conectar no DBeaver:
# se a conexão usa "Service name", preencha ORACLE_SERVICE;
# se usa "SID", comente a linha ORACLE_SERVICE e preencha ORACLE_SID.
ORACLE_SERVICE=XEPDB1
# ORACLE_SID=XE
# Só para Oracle 11g (erro DPY-3010). Exige o Oracle Instant Client instalado:
# ORACLE_THICK=1
